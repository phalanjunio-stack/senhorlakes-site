/**
 * Como a Cloudflare publica este site.
 *
 * Sem este arquivo ela olha o projeto, vê "Next.js", e conclui sozinha
 * que é um site que roda no servidor — dispara uma conversão automática
 * (OpenNext) e vai procurar `.next/standalone`, que não existe aqui.
 * O build quebra no fim, depois de tudo ter dado certo.
 *
 * Este site é `output: "export"`: o `npm run build` cospe páginas HTML
 * prontas em `out/`. Não há servidor para converter. Declarando os
 * arquivos estáticos aqui, ela para de adivinhar e só publica a pasta.
 *
 * Servir arquivo parado é o que este site precisa hoje, mas não é o
 * teto: o painel em /admin vai precisar de código rodando para receber
 * o login e gravar o conteúdo. Quando chegar a hora, entra um "main"
 * aqui apontando para esse código — o Worker atende /api e entrega os
 * arquivos estáticos no resto. É por isso que vale estar em Workers e
 * não no Pages clássico.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "senhorlakes-site",
  "compatibility_date": "2026-09-15",

  // Cada versão publicada ganharia um endereço público próprio, e o
  // Google trataria cada um como uma cópia do site competindo com o
  // original. Um site só, um endereço só.
  "preview_urls": false,
  "workers_dev": true,

  // O código que atende /api. Fora de /api a Cloudflare entrega os
  // arquivos prontos sem nem acordar este código.
  "main": "worker/index.ts",

  /**
   * Valores que não são segredo ficam aqui, e não no painel da
   * Cloudflare, por um motivo prático: cada publicação sobrescreve a
   * configuração remota com esta daqui, e variável que só existia lá é
   * apagada sem avisar. Já aconteceu duas vezes — com o endereço do
   * site e com estes dois.
   *
   * Os dois são públicos de qualquer jeito: o e-mail está no rodapé do
   * site e o repositório é aberto. O que é segredo de verdade
   * (ADMIN_SENHA_HASH, SESSAO_SEGREDO, GITHUB_TOKEN) entra como Secret
   * no painel, e Secret o deploy não apaga.
   */
  "vars": {
    "ADMIN_EMAIL": "phalanjunio@gmail.com",
    "GITHUB_REPO": "phalanjunio-stack/senhorlakes-site"
  },

  "assets": {
    "directory": "./out",
    // Só estes endereços passam pelo código; o resto é arquivo estático
    // servido direto, que é mais rápido e não custa execução.
    //
    // /audio está aí porque a entrega de arquivos estáticos da Cloudflare
    // ignora pedido de pedaço (Range): o navegador pede "do minuto 2 em
    // diante" e recebe a música inteira desde o começo, então arrastar a
    // barra do player volta tudo para o zero. No GitHub Pages funcionava.
    "run_worker_first": ["/api/*", "/audio/*"],
    // O código precisa alcançar os arquivos publicados para servir o
    // áudio pedaço por pedaço.
    "binding": "ASSETS",
    // O build gera 404.html; sem isto um endereço errado devolve uma
    // página em branco em vez do 404 do site.
    "not_found_handling": "404-page"
  }
}
