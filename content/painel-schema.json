[
  {
    "chave": "config",
    "nome": "Configurações do site",
    "arquivo": "content/config.json",
    "campos": [
      {
        "name": "googleAnalyticsId",
        "label": "Código do Google Analytics",
        "type": "string",
        "description": "Começa com G-. Pegue em analytics.google.com, em Administrador → Fluxos de dados. Vazio desliga a medição."
      },
      {
        "name": "googleSiteVerification",
        "label": "Verificação do Google Search Console",
        "type": "string",
        "description": "Só o código, sem a tag inteira. Aparece em search.google.com/search-console ao escolher a verificação por tag HTML."
      }
    ]
  },
  {
    "chave": "links",
    "nome": "Links do Instagram",
    "arquivo": "content/links.json",
    "campos": [
      {
        "name": "faixa",
        "label": "Música que toca na página",
        "type": "string",
        "description": "O código de uma música da seção Músicas. Ela fica pronta para tocar num botão, sem começar sozinha. Deixe vazio para não ter música."
      },
      {
        "name": "botoes",
        "label": "Botões",
        "type": "object",
        "list": true,
        "fields": [
          {
            "name": "rotulo",
            "label": "Texto do botão",
            "type": "string",
            "required": true
          },
          {
            "name": "tipo",
            "label": "Ícone",
            "type": "select",
            "required": true,
            "options": {
              "values": [
                {
                  "value": "whatsapp",
                  "label": "WhatsApp"
                },
                {
                  "value": "instagram",
                  "label": "Instagram"
                },
                {
                  "value": "youtube",
                  "label": "YouTube"
                },
                {
                  "value": "youtube-music",
                  "label": "YouTube Music"
                },
                {
                  "value": "spotify",
                  "label": "Spotify"
                },
                {
                  "value": "agenda",
                  "label": "Agenda"
                },
                {
                  "value": "musica",
                  "label": "Música"
                },
                {
                  "value": "site",
                  "label": "Site"
                },
                {
                  "value": "link",
                  "label": "Link comum"
                }
              ]
            }
          },
          {
            "name": "url",
            "label": "Endereço",
            "type": "string",
            "description": "Endereço completo, com https://. Para WhatsApp, Instagram, YouTube e Spotify pode deixar vazio: o botão usa o que está em \"Banda e contato\", e assim você troca num lugar só. Botão sem endereço nenhum não aparece na página."
          },
          {
            "name": "destaque",
            "label": "Botão principal",
            "type": "boolean",
            "description": "Fica maior e colorido. Use em um só — dois destaques não destacam nada."
          }
        ]
      }
    ]
  },
  {
    "chave": "shows",
    "nome": "Agenda de shows",
    "arquivo": "content/shows.json",
    "campos": [
      {
        "name": "events",
        "label": "Shows",
        "type": "object",
        "list": true,
        "fields": [
          {
            "name": "date",
            "label": "Data",
            "type": "date",
            "required": true,
            "options": {
              "format": "yyyy-MM-dd"
            }
          },
          {
            "name": "city",
            "label": "Cidade e estado",
            "type": "string",
            "required": true,
            "description": "Só a cidade e o estado, nada mais. É o que aparece em letra grande na agenda e o que o Google usa para saber onde a banda toca. Exemplo: Sete Lagoas, MG"
          },
          {
            "name": "venue",
            "label": "Nome do lugar",
            "type": "string",
            "required": true,
            "description": "Só o nome da casa, sem endereço. Exemplo: Emporio Matuto Cachaçaria"
          },
          {
            "name": "address",
            "label": "Endereço",
            "type": "string",
            "description": "Opcional. Rua, número e bairro. Exemplo: R. Ervália, 819 — Iporanga"
          },
          {
            "name": "url",
            "label": "Link de detalhes",
            "type": "string",
            "description": "Opcional — evento no Instagram, venda de ingresso, etc."
          }
        ]
      }
    ]
  },
  {
    "chave": "fotos",
    "nome": "Galeria de fotos",
    "arquivo": "content/fotos.json",
    "campos": [
      {
        "name": "photos",
        "label": "Fotos",
        "type": "object",
        "list": true,
        "fields": [
          {
            "name": "id",
            "label": "Identificador",
            "type": "string",
            "required": true,
            "description": "Qualquer código único e curto — p11, p12, show-bh…"
          },
          {
            "name": "src",
            "label": "Foto",
            "type": "image"
          },
          {
            "name": "alt",
            "label": "Descrição da foto",
            "type": "string",
            "required": true,
            "description": "Para quem não enxerga a imagem. \"A banda tocando no palco.\""
          },
          {
            "name": "category",
            "label": "Categoria",
            "type": "select",
            "required": true,
            "options": {
              "values": [
                {
                  "value": "shows",
                  "label": "Shows"
                },
                {
                  "value": "bastidores",
                  "label": "Bastidores"
                },
                {
                  "value": "retratos",
                  "label": "Retratos"
                },
                {
                  "value": "estrada",
                  "label": "Estrada"
                }
              ]
            }
          },
          {
            "name": "caption",
            "label": "Legenda",
            "type": "string"
          },
          {
            "name": "ratio",
            "label": "Formato da foto",
            "type": "select",
            "required": true,
            "description": "Define a altura dela no mosaico da galeria.",
            "options": {
              "values": [
                {
                  "value": "1.5",
                  "label": "Deitada (3:2)"
                },
                {
                  "value": "0.6667",
                  "label": "Em pé (2:3)"
                },
                {
                  "value": "1",
                  "label": "Quadrada (1:1)"
                },
                {
                  "value": "1.7778",
                  "label": "Panorâmica (16:9)"
                },
                {
                  "value": "0.8",
                  "label": "Em pé suave (4:5)"
                }
              ]
            }
          }
        ]
      }
    ]
  },
  {
    "chave": "historias",
    "nome": "Histórias",
    "arquivo": "content/historias.json",
    "campos": [
      {
        "name": "stories",
        "label": "Histórias",
        "type": "object",
        "list": true,
        "fields": [
          {
            "name": "slug",
            "label": "Endereço",
            "type": "string",
            "required": true,
            "description": "Vira o link direto para a história. Só minúsculas e hífens: de-onde-vem-o-nome."
          },
          {
            "name": "kicker",
            "label": "Chapéu",
            "type": "string",
            "description": "A palavrinha acima do título: A origem do nome, Bastidores, Na estrada…"
          },
          {
            "name": "title",
            "label": "Título",
            "type": "string",
            "required": true
          },
          {
            "name": "lead",
            "label": "Linha de apoio",
            "type": "text",
            "description": "Uma ou duas frases abaixo do título, para dar vontade de ler o resto."
          },
          {
            "name": "photo",
            "label": "Foto",
            "type": "image",
            "description": "Opcional. Sem ela a história aparece com um espaço reservado no lugar."
          },
          {
            "name": "ratio",
            "label": "Formato da foto",
            "type": "select",
            "required": true,
            "description": "Reserva o espaço certo na página. Escolher errado corta a imagem.",
            "options": {
              "values": [
                {
                  "value": "0.5625",
                  "label": "Em pé, foto de celular (9:16)"
                },
                {
                  "value": "0.6667",
                  "label": "Em pé (2:3)"
                },
                {
                  "value": "0.8",
                  "label": "Em pé suave (4:5)"
                },
                {
                  "value": "1",
                  "label": "Quadrada (1:1)"
                },
                {
                  "value": "1.5",
                  "label": "Deitada (3:2)"
                },
                {
                  "value": "1.7778",
                  "label": "Panorâmica (16:9)"
                }
              ]
            }
          },
          {
            "name": "alt",
            "label": "Descrição da foto",
            "type": "string",
            "description": "Para quem não enxerga a imagem. Exemplo: dois homens abraçados em frente a um bar."
          },
          {
            "name": "caption",
            "label": "Legenda da foto",
            "type": "string",
            "description": "O textinho que aparece embaixo da foto, no site."
          },
          {
            "name": "body",
            "label": "Texto",
            "type": "text",
            "required": true,
            "description": "Deixe uma linha em branco entre um parágrafo e outro. Para destacar um trecho, escreva **entre dois asteriscos**. Uma linha começando com > vira citação em letra grande."
          }
        ]
      }
    ]
  },
  {
    "chave": "videos",
    "nome": "Vídeos",
    "arquivo": "content/videos.json",
    "campos": [
      {
        "name": "videos",
        "label": "Vídeos",
        "type": "object",
        "list": true,
        "fields": [
          {
            "name": "youtubeId",
            "label": "Código do vídeo no YouTube",
            "type": "string",
            "required": true,
            "description": "Só o trecho depois de watch?v= — exemplo: dQw4w9WgXcQ"
          },
          {
            "name": "title",
            "label": "Título",
            "type": "string",
            "required": true
          },
          {
            "name": "description",
            "label": "Descrição",
            "type": "string"
          }
        ]
      }
    ]
  },
  {
    "chave": "albuns",
    "nome": "Álbuns e playlists",
    "arquivo": "content/albuns.json",
    "campos": [
      {
        "name": "albums",
        "label": "Álbuns",
        "type": "object",
        "list": true,
        "fields": [
          {
            "name": "slug",
            "label": "Endereço",
            "type": "string",
            "required": true,
            "description": "Vira o link do álbum. Só minúsculas e hífens — desde-sempre."
          },
          {
            "name": "title",
            "label": "Título",
            "type": "string",
            "required": true
          },
          {
            "name": "kind",
            "label": "Tipo",
            "type": "select",
            "required": true,
            "options": {
              "values": [
                "Álbum",
                "EP",
                "Single",
                "Playlist"
              ]
            }
          },
          {
            "name": "year",
            "label": "Ano",
            "type": "number",
            "required": true
          },
          {
            "name": "artwork",
            "label": "Capa",
            "type": "image",
            "description": "Imagem quadrada. Deixe vazio para o site desenhar uma capa."
          },
          {
            "name": "accent",
            "label": "Cor",
            "type": "string",
            "required": true,
            "description": "Em hexadecimal, com # na frente. Usada na capa desenhada e no fundo da página."
          },
          {
            "name": "description",
            "label": "Descrição",
            "type": "text",
            "required": true
          },
          {
            "name": "trackSlugs",
            "label": "Faixas",
            "type": "string",
            "list": true,
            "required": true,
            "description": "Os códigos das músicas, na ordem. Veja os códigos em Músicas."
          }
        ]
      }
    ]
  },
  {
    "chave": "faixas",
    "nome": "Músicas",
    "arquivo": "content/faixas.json",
    "campos": [
      {
        "name": "tracks",
        "label": "Músicas",
        "type": "object",
        "list": true,
        "fields": [
          {
            "name": "slug",
            "label": "Código",
            "type": "string",
            "required": true,
            "description": "Só minúsculas e hífens. É o que você cita na lista de faixas do álbum."
          },
          {
            "name": "title",
            "label": "Título",
            "type": "string",
            "required": true
          },
          {
            "name": "duration",
            "label": "Duração em segundos",
            "type": "number",
            "required": true,
            "description": "3:55 são 235 segundos."
          },
          {
            "name": "src",
            "label": "Arquivo",
            "type": "string",
            "required": true,
            "description": "Caminho do MP3 dentro de public/audio — exemplo: /audio/carla.mp3"
          },
          {
            "name": "cover",
            "label": "Autoria original",
            "type": "string",
            "description": "Preencha só se a música for de outro artista."
          }
        ]
      }
    ]
  },
  {
    "chave": "integrantes",
    "nome": "Integrantes",
    "arquivo": "content/integrantes.json",
    "campos": [
      {
        "name": "members",
        "label": "Integrantes",
        "type": "object",
        "list": true,
        "fields": [
          {
            "name": "name",
            "label": "Nome",
            "type": "string",
            "required": true
          },
          {
            "name": "role",
            "label": "Função",
            "type": "string",
            "required": true,
            "description": "Exemplo: Voz / guitarra"
          },
          {
            "name": "framePosition",
            "label": "Posição na foto de grupo",
            "type": "string",
            "required": true,
            "description": "Da esquerda para a direita — 5%, 27%, 49%, 70%, 92%."
          },
          {
            "name": "photo",
            "label": "Retrato individual",
            "type": "image",
            "description": "Se preencher, a posição na foto de grupo deixa de ser usada."
          },
          {
            "name": "story",
            "label": "História",
            "type": "text",
            "description": "Opcional. Quem tem história ganha um \"Ler a história\" no card, que abre num quadro por cima da página. Mesmas regras do texto das histórias: linha em branco separa parágrafos, **destaca um trecho** e > vira citação."
          }
        ]
      }
    ]
  },
  {
    "chave": "banda",
    "nome": "Banda e contato",
    "arquivo": "content/banda.json",
    "campos": [
      {
        "name": "name",
        "label": "Nome da banda",
        "type": "string",
        "required": true
      },
      {
        "name": "tagline",
        "label": "Estilo",
        "type": "string",
        "required": true
      },
      {
        "name": "claim",
        "label": "Frase da banda",
        "type": "string",
        "required": true
      },
      {
        "name": "city",
        "label": "Cidade",
        "type": "string",
        "required": true
      },
      {
        "name": "email",
        "label": "E-mail de contato",
        "type": "string",
        "required": true
      },
      {
        "name": "whatsapp",
        "label": "WhatsApp",
        "type": "string",
        "required": true,
        "description": "Só números, com país e DDD: 5531999999999"
      },
      {
        "name": "phoneLabel",
        "label": "Telefone como aparece no site",
        "type": "string",
        "required": true,
        "description": "Exemplo: (31) 9 9999-9999"
      },
      {
        "name": "instagram",
        "label": "Instagram",
        "type": "string",
        "description": "Endereço completo, com https://"
      },
      {
        "name": "youtube",
        "label": "YouTube",
        "type": "string"
      },
      {
        "name": "spotify",
        "label": "Spotify",
        "type": "string"
      }
    ]
  }
]
